{
  "name": "@getstet/stet",
  "version": "0.5.1",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Typed, versioned content keys with a committed snapshot fallback.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./core": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./store-memory": {
      "types": "./dist/adapters/store-memory.d.ts",
      "default": "./dist/adapters/store-memory.js"
    },
    "./store-snapshot": {
      "types": "./dist/adapters/store-snapshot.d.ts",
      "default": "./dist/adapters/store-snapshot.js"
    },
    "./store-pg": {
      "types": "./dist/adapters/store-pg.d.ts",
      "default": "./dist/adapters/store-pg.js"
    },
    "./store-postgrest": {
      "types": "./dist/adapters/store-postgrest.d.ts",
      "default": "./dist/adapters/store-postgrest.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/server": {
      "types": "./dist/react/server.d.ts",
      "default": "./dist/react/server.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./schema": "./descriptor.schema.json"
  },
  "bin": {
    "stet": "dist/cli/main.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dashboard",
    "dist",
    "descriptor.schema.json",
    "migrations",
    "python",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p react/tsconfig.json"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "pg": "^8.11.0",
    "react": ">=18",
    "react-dom": ">=18",
    "typescript": ">=5 <7"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
