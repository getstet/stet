{
  "apiTokenEnv": "STET_API_TOKEN",
  "bundlePath": ".stet/bundle.json",
  "codegen": {
    "defaults": "content/defaults.ts",
    "dts": "content/stet-env.d.ts",
    "registry": "content/keys.ts"
  },
  "copyModules": [],
  "descriptorPath": "content/descriptor.json",
  "emailSurfaces": [],
  "locales": {
    "default": "default",
    "enabled": [
      "default"
    ]
  },
  "managedSurfaces": [
    "app/**/*.tsx",
    "components/**/*.tsx"
  ],
  "project": "default",
  "readPath": {
    "file": "lib/content.ts",
    "import": "@/lib/content"
  },
  "rootLayout": "app/layout.tsx",
  "router": "app",
  "scan": {
    "baseline": ".stet/scan-baseline.json",
    "severity": "warn"
  },
  "snapshotPath": "content/defaults.json"
}
