{
  "color": {
    "primary": "#1f6feb",
    "onPrimary": "#ffffff",
    "primarySoft": "#e3edff",
    "primaryText": "#1a5fd0",
    "background": "#ffffff",
    "surface": "#f3f5f9",
    "text": "#111111",
    "textMuted": "#5b6472",
    "border": "#d5dae3",
    "danger": "#b42318",
    "dangerSurface": "#fdecea",
    "warning": "#8a5a00",
    "warningSurface": "#fff4d6",
    "success": "#1a7f37",
    "onSuccess": "#ffffff",
    "disabled": "#c8cdd6",
    "onDisabled": "#5f6773",
    "shimmer": "rgba(255, 255, 255, 0.65)",
    "scrim": "rgba(0, 0, 0, 0.45)"
  },
  "colorDark": {
    "primarySoft": "#17294a",
    "primaryText": "#58a6ff",
    "background": "#0d1117",
    "surface": "#161b22",
    "text": "#f0f3f6",
    "textMuted": "#9aa4b2",
    "border": "#30363d",
    "danger": "#ff8a80",
    "dangerSurface": "#3a1715",
    "warning": "#f2c35b",
    "warningSurface": "#3a2d0a",
    "success": "#238636",
    "disabled": "#30363d",
    "onDisabled": "#9aa4b2",
    "shimmer": "rgba(255, 255, 255, 0.08)",
    "scrim": "rgba(0, 0, 0, 0.6)"
  },
  "radius": { "button": 12, "card": 16, "field": 10, "pill": 999 },
  "space": { "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 32 },
  "size": { "button": 52, "field": 48 },
  "font": {
    "size": { "display": 32, "title": 26, "heading": 19, "body": 16, "button": 17, "caption": 14 },
    "weight": { "regular": "400", "semibold": "600", "bold": "700" }
  },
  "motion": {
    "duration": { "fast": 120, "base": 240, "slow": 480 },
    "spring": {
      "snappy": { "damping": 22, "stiffness": 380, "mass": 1 },
      "gentle": { "damping": 20, "stiffness": 170, "mass": 1 },
      "bouncy": { "damping": 9, "stiffness": 260, "mass": 0.9 }
    },
    "easing": { "standard": [0.2, 0, 0, 1], "emphasized": [0.05, 0.7, 0.1, 1] },
    "press": { "scale": 0.96 },
    "stagger": 70
  },

  "primaryButton": {
    "minHeight": "{size.button}",
    "radius": "{radius.button}",
    "paddingX": 20,
    "paddingY": 12,
    "borderWidth": 2,
    "label": { "fontSize": "{font.size.button}", "fontWeight": "{font.weight.semibold}" },
    "press": { "scale": "{motion.press.scale}", "spring": "{motion.spring.snappy}", "opacity": 0.85, "duration": "{motion.duration.fast}" },
    "focusRing": { "color": "{color.primary}", "width": 2, "offset": 3 },
    "loading": {
      "width": 96,
      "radius": "{radius.pill}",
      "duration": "{motion.duration.base}",
      "easing": "{motion.easing.standard}",
      "spinner": { "size": 22, "stroke": 2.5, "period": 800 }
    },
    "success": { "spring": "{motion.spring.bouncy}" },
    "primary": {
      "background": { "rest": "{color.primary}", "hovered": "{color.primary}", "pressed": "{color.primary}", "success": "{color.success}" },
      "label": { "rest": "{color.onPrimary}", "pressed": "{color.onPrimary}", "success": "{color.onSuccess}" },
      "border": { "rest": "{color.primary}", "pressed": "{color.primary}", "success": "{color.success}" }
    },
    "secondary": {
      "background": { "rest": "transparent", "hovered": "{color.primarySoft}", "pressed": "transparent", "success": "{color.success}" },
      "label": { "rest": "{color.primary}", "pressed": "{color.primary}", "success": "{color.onSuccess}" },
      "border": { "rest": "{color.primary}", "pressed": "{color.primary}", "success": "{color.success}" }
    },
    "disabled": {
      "background": { "rest": "{color.disabled}" },
      "label": { "rest": "{color.onDisabled}" },
      "border": { "rest": "{color.disabled}" }
    }
  },

  "unitsPicker": {
    "height": "{size.field}",
    "radius": "{radius.field}",
    "padding": 3,
    "track": { "background": "{color.surface}", "border": { "rest": "{color.border}", "focused": "{color.primary}" } },
    "indicator": { "background": "{color.primary}", "radius": 8, "spring": "{motion.spring.snappy}" },
    "label": {
      "fontSize": "{font.size.body}",
      "fontWeight": "{font.weight.semibold}",
      "rest": "{color.textMuted}",
      "selected": "{color.onPrimary}",
      "duration": "{motion.duration.fast}"
    },
    "press": { "opacity": 0.6 }
  },

  "weatherCard": {
    "background": "{color.surface}",
    "radius": "{radius.card}",
    "padding": "{space.lg}",
    "gap": "{space.sm}",
    "temperature": { "fontSize": 64, "fontWeight": "{font.weight.regular}", "color": "{color.text}", "countDuration": 900 },
    "entrance": { "rise": 16, "duration": "{motion.duration.slow}", "easing": "{motion.easing.emphasized}", "stagger": "{motion.stagger}" },
    "glyph": {
      "size": 52,
      "sun": "#f5a524",
      "cloud": "{color.textMuted}",
      "rain": "{color.primary}",
      "snow": "{color.textMuted}",
      "bolt": "{color.warning}",
      "spinPeriod": 16000,
      "fallPeriod": 1100
    },
    "skeleton": { "base": "{color.border}", "shimmer": "{color.shimmer}", "period": 1300 }
  },

  "notice": {
    "radius": "{radius.card}",
    "padding": "{space.md}",
    "gap": "{space.sm}",
    "stackGap": "{space.md}",
    "title": { "fontSize": "{font.size.body}", "fontWeight": "{font.weight.bold}" },
    "body": { "fontSize": "{font.size.caption}", "color": "{color.text}" },
    "info": { "background": { "rest": "{color.primarySoft}" }, "title": { "rest": "{color.primaryText}" } },
    "warning": { "background": { "rest": "{color.warningSurface}" }, "title": { "rest": "{color.warning}" } },
    "danger": { "background": { "rest": "{color.dangerSurface}" }, "title": { "rest": "{color.danger}" } },
    "enter": { "offset": 32, "spring": "{motion.spring.gentle}" },
    "swipe": { "threshold": 0.35, "spring": "{motion.spring.snappy}", "duration": "{motion.duration.base}" }
  },

  "toggle": {
    "width": 52,
    "height": 32,
    "thumbSize": 26,
    "track": { "on": "{color.primary}", "off": "{color.textMuted}" },
    "thumb": { "rest": "#ffffff" },
    "press": { "stretch": 6 },
    "spring": "{motion.spring.snappy}",
    "duration": "{motion.duration.base}"
  },

  "stepProgress": {
    "height": 6,
    "radius": "{radius.pill}",
    "track": "{color.border}",
    "fill": "{color.primary}",
    "spring": "{motion.spring.gentle}"
  },

  "textField": {
    "minHeight": "{size.field}",
    "floatingMinHeight": 58,
    "radius": "{radius.field}",
    "paddingX": 14,
    "borderWidth": 1,
    "background": "{color.surface}",
    "text": "{color.text}",
    "placeholder": "{color.textMuted}",
    "fontSize": "{font.size.body}",
    "border": { "rest": "{color.border}", "focused": "{color.primary}", "error": "{color.danger}" },
    "ring": { "focused": "{color.primarySoft}", "error": "{color.dangerSurface}", "width": 4, "duration": "{motion.duration.base}" },
    "label": { "rest": "{color.textMuted}", "focused": "{color.primaryText}", "error": "{color.danger}" },
    "labelSize": { "rest": "{font.size.body}", "floated": 12 },
    "labelSpring": "{motion.spring.snappy}",
    "message": { "fontSize": "{font.size.caption}", "hint": "{color.textMuted}", "error": "{color.danger}" },
    "shake": { "amplitude": 8, "duration": 420, "count": 3 }
  }
}
